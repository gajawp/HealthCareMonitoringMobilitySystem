OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
USE_LLM=false

# Optional file overrides
# MOBILITY_REPS_CSV=/absolute/path/to/session_reps.csv
# MOBILITY_FRAMES_CSV=/absolute/path/to/session_frames.csv
# MOBILITY_POSE_CSV=/absolute/path/to/session_pose.csv
# MOBILITY_SESSION_JSON=/absolute/path/to/session.json
# TREMOR_CSV=/absolute/path/to/tremor_validation_master.csv

# --- Email notifications for in-app messages ---
# console (default): writes fully-formatted emails to logs/emails/ and shows a
#   preview in the app. No credentials needed; safe for demos and tests.
# smtp: send through an SMTP server.   ses: send through AWS SES.
EMAIL_BACKEND=console

# SMTP (only used when EMAIL_BACKEND=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=youraddress@gmail.com
# SMTP_PASSWORD=your_16_char_app_password
# SMTP_FROM=youraddress@gmail.com

# AWS SES (only used when EMAIL_BACKEND=ses)
# SES_FROM=verified@yourdomain.com
# AWS_REGION=us-west-2
